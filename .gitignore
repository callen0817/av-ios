zsign_src/build/windows/vs2022/lib/openssl/
bin/
*.exe
*.lib
*.dll
*.so
*.dylib
!zsign_src/test/dylib/bin/*.dylib

# ----- Intermediate Build Artifacts -----
build/
x64/
[Dd]ebug/
[Rr]elease/
x86/
[Bb]in/
[Oo]bj/
*.obj
*.iobj
*.ipdb
*.pdb
*.tlog

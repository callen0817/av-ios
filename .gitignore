*.xcodeproj/project.xcworkspace/
*.xcodeproj/xcuserdata/
xcuserdata/
*.xcuserstate
*.moved-aside
*.xcarchive
*.ipa
*.app
*.dSYM/

# ----- Visual Studio & IDE State -----
.vs/
*.suo
*.user
*.userosscache
